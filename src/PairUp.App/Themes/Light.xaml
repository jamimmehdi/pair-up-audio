<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- PairUp control-room palette — light. Not an inversion: neutrals lean warm parchment
         rather than pure white/grey, and the accent hues are deepened so they hold contrast
         against a light ground instead of washing out. -->
    <SolidColorBrush x:Key="BgBrush" Color="#F2EEE3"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FCFAF3"/>
    <SolidColorBrush x:Key="Surface2Brush" Color="#F5F0E4"/>
    <SolidColorBrush x:Key="Surface3Brush" Color="#ECE4D2"/>
    <SolidColorBrush x:Key="BorderBrush2" Color="#D8CEB4"/>
    <SolidColorBrush x:Key="TextBrush" Color="#221C12"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#6E6350"/>
    <SolidColorBrush x:Key="TextFaintBrush" Color="#9C9280"/>
    <SolidColorBrush x:Key="TextOnVisualizerBrush" Color="#2A2318"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0FA98D"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#260FA98D"/>
    <SolidColorBrush x:Key="Accent2Brush" Color="#B4790A"/>
    <SolidColorBrush x:Key="Accent2DimBrush" Color="#26B4790A"/>

    <!-- Raw (non-brush) colors for code-behind consumers like the visualizer -->
    <Color x:Key="AccentColor">#0FA98D</Color>
    <Color x:Key="Accent2Color">#B4790A</Color>

    <RadialGradientBrush x:Key="MasterBarBackgroundBrush" Center="0.12,0.0" RadiusX="0.4" RadiusY="1.2" GradientOrigin="0.12,0.0">
        <GradientStop Color="#0A0FA98D" Offset="0"/>
        <GradientStop Color="#F2EEE3" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="LogoMarkBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#33E0C0" Offset="0"/>
        <GradientStop Color="#1F9E86" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="LogoGlyphBrush" Color="#0C1512"/>

</ResourceDictionary>
