<Window x:Class="PairUp.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen" Width="240" Height="240">
    <Border Background="#14120F" CornerRadius="20" Opacity="0.97">
        <Grid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border x:Name="LogoMark" Width="88" Height="88" CornerRadius="24" RenderTransformOrigin="0.5,0.5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#33E0C0" Offset="0"/>
                            <GradientStop Color="#1F9E86" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="0.7" ScaleY="0.7"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect Color="#33E0C0" BlurRadius="28" ShadowDepth="0" Opacity="0.55"/>
                    </Border.Effect>
                    <Viewbox Width="48" Height="48">
                        <Path Data="M3 12c2-4 4-6 5-6s2 8 4 8 2-10 4-10 3 8 5 8"
                              Stroke="#0C1512" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Viewbox>
                </Border>

                <TextBlock x:Name="Wordmark" Text="PAIRUP" FontFamily="Bahnschrift SemiBold, Segoe UI Semibold"
                           FontSize="18" Foreground="#f3ede1" HorizontalAlignment="Center"
                           Margin="0,20,0,0" Opacity="0">
                    <TextBlock.RenderTransform>
                        <TranslateTransform x:Name="WordmarkOffset" Y="8"/>
                    </TextBlock.RenderTransform>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Border>
</Window>
